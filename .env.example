# Copy this file to .env and fill in values for your provider.
# PowerShell: Copy-Item .env.example .env
# macOS/Linux: cp .env.example .env

# Required for `pnpm run course`.
# For OpenAI, use https://api.openai.com/v1 or leave OPENAI_BASE_URL empty.
# For OpenAI-compatible providers, use the provider's /v1 endpoint and model names.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_TEXT_MODEL=

# Voice provider: auto, openai-audio, or dashscope-http.
# auto tries OpenAI audio first, then DashScope HTTP TTS, then Windows zh-CN speech on Windows.
VOICE_PROVIDER=auto
OPENAI_AUDIO_MODEL=
OPENAI_AUDIO_VOICE=alloy
VOICE_REQUIRE_AUDIO_MODEL=false
VOICE_AUDIO_MODEL_RETRIES=3
VOICE_SLIDE_GAP_SECONDS=0.35
OPENAI_REQUEST_TIMEOUT_MS=20000

# Optional OpenAI speech fallback. Leave OPENAI_TTS_FALLBACK_MODEL empty to disable.
OPENAI_TTS_FALLBACK_MODEL=
OPENAI_TTS_FALLBACK_VOICE=nova

# Required only when VOICE_PROVIDER includes dashscope-http.
# Uses DashScope HTTP SpeechSynthesizer through Node fetch; no Python SDK or WebSocket is required.
DASHSCOPE_API_KEY=
DASHSCOPE_TTS_MODEL=cosyvoice-v3-flash
DASHSCOPE_TTS_VOICE=longxiaochun_v3
DASHSCOPE_TTS_SAMPLE_RATE=24000
DASHSCOPE_TTS_TIMEOUT_MS=120000

# Document mode and render output.
DOCUMENT_PAGE_SECONDS=6
VIDEO_OUTPUT=out/doc-video-generator.mp4
CLEAN_AFTER_RENDER=true
KEEP_ARTIFACTS=false
STRICT_THEME=false
