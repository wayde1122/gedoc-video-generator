# Copy this file to .env and fill in values for your provider.
# PowerShell: Copy-Item .env.example .env
# macOS/Linux: cp .env.example .env

# Required for `pnpm run course`.
# For OpenAI, use https://api.openai.com/v1 or leave OPENAI_BASE_URL empty.
# For OpenAI-compatible providers, use the provider's /v1 endpoint and model names.
OPENAI_API_KEY=your_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=your_text_model

# Voice provider: none, openai, dashscope, xiaomi, or windows.
# `auto` is intentionally unsupported. Pick one provider explicitly.
PROVIDER=none
MODE_API_KEY=
MODEL=
MODEL_VOICE=
MODEL_TTS_TIMEOUT_MS=120000
BASE_URL=
VOICE_SPEED=1.15
VOICE_SLIDE_GAP_SECONDS=0.35

# Document mode and render output.
DOCUMENT_PAGE_SECONDS=6
# Leave VIDEO_OUTPUT empty to generate out/<course-title>.mp4.
VIDEO_OUTPUT=
CLEAN_AFTER_RENDER=true
KEEP_ARTIFACTS=false
STRICT_THEME=false
