{
  "name": "doc-video-generator",
  "private": true,
  "type": "module",
  "scripts": {
    "course": "tsx scripts/generate-course.ts",
    "doc:prepare": "tsx scripts/prepare-document.ts",
    "doc:demo": "pnpm run doc:prepare && pnpm run render",
    "voice": "tsx scripts/generate-voice.ts",
    "render": "tsx scripts/render-video.ts",
    "clean": "tsx scripts/cleanup-artifacts.ts",
    "demo": "pnpm run course && pnpm run render",
    "demo:voice": "pnpm run course && pnpm run voice -- --force && pnpm run render",
    "demo:current": "pnpm run render",
    "demo:current:voice": "pnpm run voice && pnpm run render",
    "studio": "remotion studio src/index.tsx",
    "env:check": "tsx scripts/check-env.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run test",
    "test": "pnpm run test:themes && pnpm run test:voice-providers",
    "test:themes": "tsx tests/theme-migration.test.ts",
    "test:voice-providers": "tsx tests/voice-provider-registry.test.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@remotion/cli": "4.0.464",
    "dotenv": "^17.2.3",
    "ffmpeg-static": "^5.2.0",
    "openai": "^6.39.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "remotion": "4.0.464",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
